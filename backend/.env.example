# Skopiuj do backend/.env i uzupełnij. Bez klucza aplikacja działa w trybie DEMO (mock).

# --- Claude Vision (warstwa 1) ---
ANTHROPIC_API_KEY=
# Model z widzeniem (konfigurowalny):
ANTHROPIC_MODEL=claude-opus-4-8
# Wymuś tryb demo nawet z kluczem (1/true):
FSA_MOCK_MODE=

# --- Dane fundamentalne (opcjonalne) ---
# Darmowy klucz FRED do odświeżania stóp na żywo (https://fred.stlouisfed.org/docs/api/api_key.html):
FRED_API_KEY=

# --- Reguły analizy (kalibrowalne bez zmiany kodu) ---
FSA_ENTRY_THRESHOLD=7
FSA_MIN_RR=2.0
# Bufor SL jako ułamek dystansu wejście-ekstremum (0.1 = 10%):
FSA_SL_BUFFER_PCT=0.1

# --- Storage ---
# FSA_DB_PATH=/absolutna/sciezka/history.db
