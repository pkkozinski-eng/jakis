# ── cTrader Open API credentials ─────────────────────────────────────────────
# Create an application at https://openapi.ctrader.com/ and copy its credentials.
CTRADER_CLIENT_ID=your_client_id_here
CTRADER_CLIENT_SECRET=your_client_secret_here

# OAuth access token for your trading account.
# Get it by running:  npm run oauth   (see README.md)
CTRADER_ACCESS_TOKEN=your_access_token_here

# The numeric trading account id (ctidTraderAccountId).
# The `npm run oauth` helper prints all account ids linked to your token.
CTRADER_ACCOUNT_ID=12345678

# ── Connection target ────────────────────────────────────────────────────────
# "demo" -> demo.ctraderapi.com, "live" -> live.ctraderapi.com
CTRADER_ENV=demo

# Advanced: override host/port explicitly (usually not needed).
# CTRADER_HOST=demo.ctraderapi.com
# CTRADER_PORT=5035

# ── MCP HTTP server ──────────────────────────────────────────────────────────
# Must match the url in .mcp.json (default http://127.0.0.1:9876/mcp/)
MCP_HOST=127.0.0.1
MCP_PORT=9876

# OAuth helper redirect (must match the redirect URI configured in your cTrader app)
OAUTH_REDIRECT_PORT=5033
