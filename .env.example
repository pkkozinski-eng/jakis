# Skopiuj do .env i dostosuj. Wszystkie zmienne sa opcjonalne.

# Port serwera (domyslnie 3000)
PORT=3000

# Konto administratora tworzone przy pierwszym starcie.
# Jesli nie ustawisz ADMIN_PIN, zostanie wygenerowany losowo i wypisany w konsoli.
ADMIN_NICK=admin
ADMIN_PIN=1234

# Sciezka pliku bazy SQLite. Na wdrozeniach z trwalym dyskiem ustaw sciezke
# wskazujaca na zamontowany wolumen, np. /data/typer.db
DATABASE_FILE=./data/typer.db

# Sekret podpisujacy tokeny sesji. Jesli pusty, generowany raz i zapisany w bazie.
# SESSION_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# Opcjonalnie: darmowy token z https://www.football-data.org/ do auto-pobierania wynikow.
# FOOTBALL_DATA_TOKEN=twoj_token
